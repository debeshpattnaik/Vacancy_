# Database Settings
DB_PATH=data/vacancies.db

# Scraping Settings
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
TIMEOUT_SECONDS=30
RETRY_COUNT=3
DELAY_BETWEEN_REQUESTS=2.0

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=logs/tracker.log
